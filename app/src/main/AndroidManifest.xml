<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only requested from the optional Settings button, for screen-off live voice. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 0.2.10: without this the network-aware reconnect could not see the network at all — the
         platform threw SecurityException, the exception was swallowed, and the diagnostics line
         said "Network: unknown" forever (the 0.2.9 phone report).
         https://developer.android.com/reference/android/Manifest.permission#ACCESS_NETWORK_STATE -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The microphone foreground service permits continued background capture; it is not a
         power-management or network exemption. Documented requirements:
         https://developer.android.com/develop/background-work/services/fgs/service-types#microphone
         FOREGROUND_SERVICE is the base permission (Android 14+ requires it in addition to the
         type-specific one); POST_NOTIFICATIONS (Android 13+) is needed for the visible notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 0.2.7 in-app updater: needed to hand a downloaded APK to the system installer.
         https://developer.android.com/guide/topics/manifest/uses-permission#android.permission.REQUEST_INSTALL_PACKAGES -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="AGI"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 0.2.9: keeps the microphone session alive in the background (type "microphone"). -->
        <service
            android:name=".LiveSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 0.2.20: YouTube player — the foreground media service keeps audio playing when
             the phone is locked, and puts play/pause/next on the lock screen. -->
        <service
            android:name=".youtube.YouTubePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The updater downloads into the app cache and shares that one file with the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receives the installer's verdict for the committed session (never assumes success). -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sojibhuiya.jarves.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
